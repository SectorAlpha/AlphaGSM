#!/usr/bin/env bash

set -euo pipefail

MANAGER_HOST_UID="$EUID"
if [[ ! "$MANAGER_HOST_UID" =~ ^[0-9]+$ ]]; then
    echo "Unable to determine the invoking process's numeric UID:GID." >&2
    exit 1
fi
if [[ "$MANAGER_HOST_UID" == "0" ]]; then
    echo "AlphaGSM refuses to run the manager container as UID 0." >&2
    exit 1
fi
if [[ -x /usr/bin/id ]]; then
    MANAGER_HOST_GID="$(/usr/bin/id -g)"
elif [[ -x /bin/id ]]; then
    MANAGER_HOST_GID="$(/bin/id -g)"
else
    echo "Unable to locate a trusted id executable for the invoking process's numeric GID." >&2
    exit 1
fi
if [[ ! "$MANAGER_HOST_GID" =~ ^[0-9]+$ ]]; then
    echo "Unable to determine the invoking process's numeric UID:GID." >&2
    exit 1
fi

normalize_absolute_path() {
    local path="$1"
    local part
    local normalized=""
    local -a parts=()

    if [[ "$path" != /* ]]; then
        path="$PWD/$path"
    fi
    IFS='/' read -r -a parts <<< "$path"
    for part in "${parts[@]}"; do
        case "$part" in
            ""|.)
                ;;
            ..)
                normalized="${normalized%/*}"
                ;;
            *)
                normalized="$normalized/$part"
                ;;
        esac
    done
    printf '%s\n' "${normalized:-/}"
}

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker/manager/compose.yml"
STATE_DIR="${ALPHAGSM_HOME:-$SCRIPT_DIR/.alphagsm-docker}"
STATE_DIR="$(normalize_absolute_path "$STATE_DIR")"
CONFIG_PATH="$STATE_DIR/alphagsm.conf"
EXAMPLE_CONFIG="$SCRIPT_DIR/docker/manager/alphagsm.conf.example"
PULL_RUNTIME_IMAGES="${ALPHAGSM_PULL_RUNTIME_IMAGES:-0}"
MANAGER_CONTAINER_NAME="${ALPHAGSM_MANAGER_CONTAINER_NAME:-alphagsm-manager}"
MANAGER_MODE_FILE="$STATE_DIR/.manager-mode"
DEFAULT_MANAGER_IMAGE="${ALPHAGSM_MANAGER_IMAGE:-ghcr.io/sectoralpha/alphagsm:latest}"
DEVELOP_MANAGER_IMAGE="${ALPHAGSM_MANAGER_DEVELOP_IMAGE:-alphagsm:dev}"
MANAGER_DOCKER_GID=""
MANAGER_DOCKER_SOCKET=""

compose_cmd() {
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
        return
    fi
    if command -v docker-compose >/dev/null 2>&1; then
        docker-compose "$@"
        return
    fi
    echo "Docker Compose is required. Install Docker Compose plugin or docker-compose." >&2
    exit 1
}

state_path_symlink_component() {
    local component
    local current=""
    local -a components=()

    IFS='/' read -r -a components <<< "$STATE_DIR"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        current="$current/$component"
        if [[ -L "$current" ]]; then
            printf '%s\n' "$current"
            return 0
        fi
    done
    return 1
}

state_entry_metadata() {
    local path="$1"
    local metadata=""

    if ! metadata="$(stat -c '%u|%g|%a|%F' "$path" 2>/dev/null)"; then
        metadata="$(stat -f '%u|%g|%Lp|%HT' "$path" 2>/dev/null || true)"
    fi
    [[ -n "$metadata" ]] || return 1
    printf '%s\n' "$metadata"
}

state_entry_failure_reason() {
    local path="$1"
    local metadata
    local owner_uid
    local owner_gid
    local mode
    local file_type
    local permission_digit
    local required_bits

    if ! metadata="$(state_entry_metadata "$path")"; then
        printf 'metadata inspection failed'
        return 1
    fi
    IFS='|' read -r owner_uid owner_gid mode file_type <<< "$metadata"
    if [[ ! "$owner_uid" =~ ^[0-9]+$ || ! "$owner_gid" =~ ^[0-9]+$ || ! "$mode" =~ ^[0-7]+$ ]]; then
        printf 'metadata inspection was ambiguous'
        return 1
    fi

    case "$file_type" in
        *symbolic*link*|*Symbolic*Link*)
            printf 'symbolic links are not allowed in manager state'
            return 1
            ;;
        *directory*|*Directory*)
            required_bits=3
            ;;
        *regular*file*|*Regular*File*)
            required_bits=2
            ;;
        *)
            printf 'unsupported state entry type: %s' "$file_type"
            return 1
            ;;
    esac

    mode="${mode: -3}"
    if [[ "$owner_uid" == "$MANAGER_HOST_UID" ]]; then
        permission_digit="${mode:0:1}"
    elif [[ "$owner_gid" == "$MANAGER_HOST_GID" ]]; then
        permission_digit="${mode:1:1}"
    else
        permission_digit="${mode:2:1}"
    fi
    if (( (8#$permission_digit & required_bits) != required_bits )); then
        printf 'not writable%s by host UID:GID %s:%s' \
            "$([[ "$required_bits" == "3" ]] && printf '/traversable')" \
            "$MANAGER_HOST_UID" \
            "$MANAGER_HOST_GID"
        return 1
    fi
}

fail_unsafe_manager_state() {
    local unsafe_path="$1"
    local reason="$2"

    echo "Refusing to recreate the manager because its state tree is unsafe for host UID:GID ${MANAGER_HOST_UID}:${MANAGER_HOST_GID}." >&2
    echo "State path: $STATE_DIR" >&2
    echo "Unsafe state entry: $unsafe_path ($reason)." >&2
    echo "Existing state was preserved; AlphaGSM will not chown or delete it automatically." >&2
    echo "After verifying this is the intended state tree, repair its ownership as an administrator:" >&2
    printf '  sudo chown -R %s:%s -- %q\n' \
        "$MANAGER_HOST_UID" \
        "$MANAGER_HOST_GID" \
        "$STATE_DIR" >&2
    if [[ "$reason" == *"symbolic link"* ]]; then
        echo "Replace the symbolic link with state owned directly at $STATE_DIR before retrying." >&2
    fi
    exit 1
}

preflight_existing_manager_state() {
    local symlink_component
    local failure
    local unsafe_path
    local reason

    if [[ ! -e "$STATE_DIR" && ! -L "$STATE_DIR" ]]; then
        return
    fi
    if symlink_component="$(state_path_symlink_component)"; then
        fail_unsafe_manager_state "$symlink_component" "symbolic link in state path"
    fi
    if failure="$(
        find -P "$STATE_DIR" -print0 |
            while IFS= read -r -d '' path; do
                if ! reason="$(state_entry_failure_reason "$path")"; then
                    printf '%s\n%s\n' "$path" "$reason"
                    exit 1
                fi
            done
    )"; then
        return
    fi

    unsafe_path="$(printf '%s\n' "$failure" | sed -n '1p')"
    reason="$(printf '%s\n' "$failure" | sed -n '2p')"
    fail_unsafe_manager_state "${unsafe_path:-$STATE_DIR}" "${reason:-state inspection failed}"
}

ensure_config() {
    mkdir -p "$STATE_DIR"
    if [[ -f "$CONFIG_PATH" ]]; then
        return
    fi

    sed "s|/srv/alphagsm|$STATE_DIR|g" "$EXAMPLE_CONFIG" > "$CONFIG_PATH"
    echo "Wrote $CONFIG_PATH"
}

normalize_manager_mode() {
    case "${1:-}" in
        ""|release|default)
            printf 'release\n'
            ;;
        develop|developer|dev)
            printf 'develop\n'
            ;;
        *)
            echo "Unknown manager mode: $1" >&2
            exit 1
            ;;
    esac
}

persist_manager_mode() {
    printf '%s\n' "$1" > "$MANAGER_MODE_FILE"
}

current_manager_mode() {
    if [[ -n "${ALPHAGSM_MANAGER_MODE:-}" ]]; then
        normalize_manager_mode "$ALPHAGSM_MANAGER_MODE"
        return
    fi
    if [[ -f "$MANAGER_MODE_FILE" ]]; then
        normalize_manager_mode "$(head -n 1 "$MANAGER_MODE_FILE")"
        return
    fi
    printf 'release\n'
}

manager_image_for_mode() {
    case "$1" in
        develop)
            printf '%s\n' "$DEVELOP_MANAGER_IMAGE"
            ;;
        *)
            printf '%s\n' "$DEFAULT_MANAGER_IMAGE"
            ;;
    esac
}

manager_compose() {
    local mode="${1:-}"
    local image

    if [[ -z "$mode" ]]; then
        mode="$(current_manager_mode)"
    fi
    image="$(manager_image_for_mode "$mode")"
    resolve_manager_identity

    ALPHAGSM_HOME="$STATE_DIR" \
    ALPHAGSM_PULL_RUNTIME_IMAGES="$PULL_RUNTIME_IMAGES" \
    ALPHAGSM_MANAGER_IMAGE="$image" \
    ALPHAGSM_HOST_UID="$MANAGER_HOST_UID" \
    ALPHAGSM_HOST_GID="$MANAGER_HOST_GID" \
    ALPHAGSM_DOCKER_GID="$MANAGER_DOCKER_GID" \
    ALPHAGSM_DOCKER_SOCKET="$MANAGER_DOCKER_SOCKET" \
    compose_cmd -f "$COMPOSE_FILE" "${@:2}"
}

resolve_manager_identity() {
    if [[ -n "$MANAGER_DOCKER_GID" ]]; then
        return
    fi

    MANAGER_DOCKER_SOCKET="$(resolve_docker_socket)"
    MANAGER_DOCKER_GID="$(resolve_docker_socket_gid "$MANAGER_DOCKER_SOCKET")"
}

resolve_docker_socket() {
    local socket_path="${ALPHAGSM_DOCKER_SOCKET:-}"

    if [[ -z "$socket_path" && "${DOCKER_HOST:-}" == unix://* ]]; then
        socket_path="${DOCKER_HOST#unix://}"
    fi
    socket_path="${socket_path:-/var/run/docker.sock}"
    if [[ "$socket_path" != /* ]]; then
        echo "ALPHAGSM_DOCKER_SOCKET must be an absolute path." >&2
        exit 1
    fi
    normalize_absolute_path "$socket_path"
}

resolve_docker_socket_gid() {
    local socket_path="$1"
    local docker_gid=""

    if ! docker_gid="$(stat -c '%g' "$socket_path" 2>/dev/null)"; then
        docker_gid="$(stat -f '%g' "$socket_path" 2>/dev/null || true)"
    fi
    if [[ ! "$docker_gid" =~ ^[0-9]+$ ]]; then
        echo "Unable to determine the numeric group ID for Docker socket $socket_path." >&2
        exit 1
    fi
    printf '%s\n' "$docker_gid"
}

docker_image_exists() {
    docker image inspect "$1" >/dev/null 2>&1
}

try_pull_manager_image() {
    docker pull "$1"
}

manager_running() {
    [[ "$(docker inspect -f '{{.State.Running}}' "$MANAGER_CONTAINER_NAME" 2>/dev/null || true)" == "true" ]]
}

manager_exists() {
    docker inspect "$MANAGER_CONTAINER_NAME" >/dev/null 2>&1
}

manager_identity_matches() {
    local configured_identity
    local expected_identity

    resolve_manager_identity
    configured_identity="$(
        docker inspect -f '{{.Config.User}}|{{json .HostConfig.GroupAdd}}' \
            "$MANAGER_CONTAINER_NAME" 2>/dev/null || true
    )"
    expected_identity="${MANAGER_HOST_UID}:${MANAGER_HOST_GID}|[\"${MANAGER_DOCKER_GID}\"]"
    [[ "$configured_identity" == "$expected_identity" ]] || return 1
    manager_socket_source_matches
}

manager_socket_source_matches() {
    local inspected_sources
    local -a sources=()

    if ! inspected_sources="$(
        docker inspect -f \
            '{{range .Mounts}}{{if eq .Destination "/var/run/docker.sock"}}{{println .Source}}{{end}}{{end}}' \
            "$MANAGER_CONTAINER_NAME" 2>/dev/null
    )"; then
        return 1
    fi
    mapfile -t sources <<< "$inspected_sources"
    [[ "${#sources[@]}" == "1" && -n "${sources[0]}" ]] || return 1
    [[ "${sources[0]}" == "$MANAGER_DOCKER_SOCKET" ]]
}

guard_existing_manager_identity() {
    local mode="$1"

    if ! manager_exists; then
        return
    fi
    if manager_identity_matches; then
        return
    fi

    echo "Manager container identity or Docker socket mount changed; recreating it in $mode mode."
    ensure_manager "$mode" 1
}

docker_container_running() {
    [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null || true)" == "true" ]]
}

host_python3_available() {
    if ! command -v python3 >/dev/null 2>&1; then
        return 1
    fi

    python3 -c "pass" >/dev/null 2>&1
}

require_host_python3() {
    if host_python3_available; then
        return 0
    fi

    echo "Host python3 is required for './alphagsm-docker ps' because the wrapper reads local server metadata." >&2
    exit 1
}

server_container_name() {
    printf 'alphagsm-%s\n' "$1"
}

server_config_path() {
    printf '%s/home/conf/%s.json\n' "$STATE_DIR" "$1"
}

load_server_runtime_metadata() {
    local server_name="$1"
    local path
    path="$(server_config_path "$server_name")"
    [[ -f "$path" ]] || return 1

    python3 - "$path" "$server_name" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
server_name = sys.argv[2]
data = json.loads(path.read_text(encoding="utf-8"))
runtime = str(data.get("runtime", "")).strip()
container_name = str(data.get("container_name", "")).strip() or f"alphagsm-{server_name}"
print(runtime)
print(container_name)
PY
}

resolve_server_container_name() {
    local server_name="$1"
    local metadata
    local runtime_name
    local container_name

    if host_python3_available && metadata="$(load_server_runtime_metadata "$server_name" 2>/dev/null)"; then
        runtime_name="$(printf '%s\n' "$metadata" | sed -n '1p')"
        container_name="$(printf '%s\n' "$metadata" | sed -n '2p')"
        if [[ "$runtime_name" == "docker" && -n "$container_name" ]]; then
            printf '%s\n' "$container_name"
            return 0
        fi
    fi

    server_container_name "$server_name"
}

list_server_config_names() {
    local conf_dir="$STATE_DIR/home/conf"

    [[ -d "$conf_dir" ]] || return 0

    find "$conf_dir" -maxdepth 1 -type f -name '*.json' -printf '%f\n' \
        | sed 's/\.json$//' \
        | sort
}

container_port_lines() {
    docker port "$1" 2>/dev/null || true
}

print_docker_server_list() {
    local server_name
    local metadata
    local runtime_name
    local container_name
    local state
    local ports
    local printed=0

    while IFS= read -r server_name; do
        [[ -n "$server_name" ]] || continue
        metadata="$(load_server_runtime_metadata "$server_name" 2>/dev/null || true)"
        [[ -n "$metadata" ]] || continue

        runtime_name="$(printf '%s\n' "$metadata" | sed -n '1p')"
        [[ "$runtime_name" == "docker" ]] || continue

        container_name="$(printf '%s\n' "$metadata" | sed -n '2p')"
        if docker_container_running "$container_name"; then
            state="running"
            ports="$(container_port_lines "$container_name" | paste -sd ';' -)"
        elif docker inspect "$container_name" >/dev/null 2>&1; then
            state="stopped"
            ports="$(container_port_lines "$container_name" | paste -sd ';' -)"
        else
            state="missing"
            ports=""
        fi

        if [[ "$printed" == "0" ]]; then
            printf '%-20s %-28s %-10s %s\n' "SERVER" "CONTAINER" "STATE" "PORTS"
        fi
        printf '%-20s %-28s %-10s %s\n' "$server_name" "$container_name" "$state" "$ports"
        printed=1
    done < <(list_server_config_names)

    if [[ "$printed" == "0" ]]; then
        echo "No Docker-backed AlphaGSM servers found in the current wrapper home."
    fi
}

connect_server_console() {
    local server_name="$1"
    local show_logs="${2:-1}"
    local log_tail_lines="${3:-${ALPHAGSM_CONNECT_LOG_TAIL:-10}}"
    local detach_keys="${4:-${ALPHAGSM_CONNECT_DETACH_KEYS:-}}"
    local metadata
    local runtime_name
    local container_name
    local recent_logs

    if ! metadata="$(load_server_runtime_metadata "$server_name")"; then
        echo "Server '$server_name' is not defined in $STATE_DIR/home/conf" >&2
        exit 1
    fi

    runtime_name="$(printf '%s\n' "$metadata" | sed -n '1p')"
    container_name="$(printf '%s\n' "$metadata" | sed -n '2p')"

    if [[ "$runtime_name" != "docker" ]]; then
        echo "Wrapper connect only attaches to Docker-backed servers." >&2
        exit 1
    fi

    if ! docker inspect "$container_name" >/dev/null 2>&1; then
        echo "Container '$container_name' was not found. Run './alphagsm-docker $server_name status' or './alphagsm-docker $server_name start' first." >&2
        exit 1
    fi

    if ! docker_container_running "$container_name"; then
        echo "Container '$container_name' is not running. Run './alphagsm-docker $server_name start' first." >&2
        exit 1
    fi

    recent_logs=""
    if [[ "$show_logs" == "1" ]]; then
        recent_logs="$(docker logs --tail "$log_tail_lines" "$container_name" 2>/dev/null || true)"
    fi
    if [[ -n "$recent_logs" ]]; then
        echo "Recent container logs (last $log_tail_lines lines):"
        printf '%s\n' "$recent_logs"
        echo
    fi

    echo "Connecting to $container_name"
    if [[ -n "$detach_keys" ]]; then
        echo "Detach with Docker escape sequence: $detach_keys"
        docker attach --detach-keys "$detach_keys" "$container_name"
    else
        echo "Detach with Ctrl-p Ctrl-q"
        docker attach "$container_name"
    fi
}

route_connect_command() {
    local server_name="$1"
    local show_logs=1
    local log_tail_lines="${ALPHAGSM_CONNECT_LOG_TAIL:-10}"
    local detach_keys="${ALPHAGSM_CONNECT_DETACH_KEYS:-}"
    local metadata
    local runtime_name
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            connect)
                shift
                ;;
            --no-logs)
                show_logs=0
                shift
                ;;
            --tail)
                if [[ $# -lt 2 ]]; then
                    echo "Missing value for --tail" >&2
                    exit 1
                fi
                if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                    echo "--tail requires a non-negative integer" >&2
                    exit 1
                fi
                log_tail_lines="$2"
                shift 2
                ;;
            --tail=*)
                log_tail_lines="${1#--tail=}"
                if [[ ! "$log_tail_lines" =~ ^[0-9]+$ ]]; then
                    echo "--tail requires a non-negative integer" >&2
                    exit 1
                fi
                shift
                ;;
            --detach-keys)
                if [[ $# -lt 2 ]]; then
                    echo "Missing value for --detach-keys" >&2
                    exit 1
                fi
                detach_keys="$2"
                shift 2
                ;;
            --detach-keys=*)
                detach_keys="${1#--detach-keys=}"
                shift
                ;;
            *)
                echo "Unknown option for connect: $1" >&2
                exit 1
                ;;
        esac
    done

    if ! host_python3_available; then
        exec_alphagsm "$server_name" connect
        return
    fi

    if ! metadata="$(load_server_runtime_metadata "$server_name" 2>/dev/null)"; then
        exec_alphagsm "$server_name" connect
        return
    fi

    runtime_name="$(printf '%s\n' "$metadata" | sed -n '1p')"
    if [[ "$runtime_name" != "docker" ]]; then
        exec_alphagsm "$server_name" connect
        return
    fi

    connect_server_console "$server_name" "$show_logs" "$log_tail_lines" "$detach_keys"
}

show_host_connection_details() {
    local server_name="$1"
    local container_name
    local port_lines
    local line
    local display_host
    local host_port
    local proto
    local raw_host
    local seen_key

    declare -A seen_connect=()

    container_name="$(resolve_server_container_name "$server_name")"
    if ! docker inspect "$container_name" >/dev/null 2>&1; then
        return 0
    fi

    if [[ "$(docker inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)" != "true" ]]; then
        return 0
    fi

    port_lines="$(docker port "$container_name" 2>/dev/null || true)"
    if [[ -z "$port_lines" ]]; then
        return 0
    fi

    echo
    echo "Host connection details:"
    echo "  Host: 127.0.0.1 (or this machine's reachable IP)"
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        echo "  $line"

        if [[ "$line" =~ ^[0-9]+/([a-z]+)[[:space:]]+\-\>[[:space:]]+(.*):([0-9]+)$ ]]; then
            proto="${BASH_REMATCH[1]}"
            raw_host="${BASH_REMATCH[2]}"
            host_port="${BASH_REMATCH[3]}"
            raw_host="${raw_host#[}"
            raw_host="${raw_host%]}"
            case "$raw_host" in
                ""|0.0.0.0|::)
                    display_host="127.0.0.1"
                    ;;
                *)
                    display_host="$raw_host"
                    ;;
            esac
            seen_key="$display_host:$host_port/$proto"
            if [[ -z "${seen_connect[$seen_key]:-}" ]]; then
                echo "  Connect from this host: $display_host:$host_port/$proto"
                seen_connect[$seen_key]=1
            fi
        fi
    done <<< "$port_lines"
}

wait_for_manager_running() {
    local attempt

    for attempt in $(seq 1 20); do
        if manager_running; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

ensure_manager() {
    local mode="${1:-}"
    local force_refresh="${2:-0}"
    local image
    local up_args=()
    local state_preflight_done=0

    if [[ -z "$mode" ]]; then
        mode="$(current_manager_mode)"
    fi

    resolve_manager_identity
    if [[ "$force_refresh" == "1" ]] && manager_exists; then
        preflight_existing_manager_state
        state_preflight_done=1
    fi
    if [[ "$force_refresh" != "1" ]] && wait_for_manager_running; then
        if manager_identity_matches; then
            ensure_config
            return
        fi
        preflight_existing_manager_state
        state_preflight_done=1
        echo "Manager container identity or Docker socket mount changed; recreating it in $mode mode."
        force_refresh=1
    fi
    if [[ "$state_preflight_done" == "0" ]] && manager_exists; then
        preflight_existing_manager_state
    fi
    ensure_config

    image="$(manager_image_for_mode "$mode")"
    if manager_exists || [[ "$force_refresh" == "1" ]]; then
        up_args+=(--force-recreate)
    fi

    if [[ "$mode" == "develop" ]]; then
        echo "Developer mode: building AlphaGSM manager image locally..."
        manager_compose "$mode" up -d --build "${up_args[@]}"
    else
        if try_pull_manager_image "$image" >/dev/null 2>&1; then
            echo "Pulled AlphaGSM manager image: $image"
            manager_compose "$mode" up -d "${up_args[@]}"
        elif docker_image_exists "$image"; then
            echo "Using existing local AlphaGSM manager image: $image"
            manager_compose "$mode" up -d "${up_args[@]}"
        else
            echo "Unable to pull $image. Building the AlphaGSM manager image locally..."
            manager_compose "$mode" up -d --build "${up_args[@]}"
        fi
    fi

    if manager_running; then
        return
    fi

    echo "AlphaGSM manager container failed to stay running after startup." >&2
    manager_compose "$mode" logs alphagsm >&2 || true
    exit 1
}

exec_alphagsm() {
    ensure_manager "$(current_manager_mode)"
    echo "Running AlphaGSM command in manager container..."
    manager_compose "$(current_manager_mode)" exec -T alphagsm python alphagsm "$@"
    if [[ $# -ge 2 && ( "$2" == "status" || "$2" == "start" ) ]]; then
        show_host_connection_details "$1"
    fi
}

parse_start_mode() {
    local mode="release"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --develop)
                mode="develop"
                ;;
            --release)
                mode="release"
                ;;
            *)
                echo "Unknown option for start/up: $1" >&2
                exit 1
                ;;
        esac
        shift
    done

    printf '%s\n' "$mode"
}

show_help() {
    cat <<EOF
Usage:
  ./alphagsm-docker up
    ./alphagsm-docker start
    ./alphagsm-docker up --develop
        ./alphagsm-docker start --develop
  ./alphagsm-docker down
    ./alphagsm-docker stop
  ./alphagsm-docker shell
  ./alphagsm-docker logs
  ./alphagsm-docker compose <compose-args>
  ./alphagsm-docker ps
  ./alphagsm-docker <server> connect
    ./alphagsm-docker <server> connect --tail <n>
    ./alphagsm-docker <server> connect --no-logs
        ./alphagsm-docker <server> connect --detach-keys <seq>
  ./alphagsm-docker <alphagsm-args>

Examples:
  ./alphagsm-docker up
    ./alphagsm-docker start --develop
  ./alphagsm-docker mymc create minecraft.vanilla
  ./alphagsm-docker mymc setup -n 25565 "$STATE_DIR/servers/mymc"
  ./alphagsm-docker mymc start
  ./alphagsm-docker mymc connect
    ./alphagsm-docker mymc connect --tail 25
    ./alphagsm-docker mymc connect --no-logs
        ./alphagsm-docker mymc connect --detach-keys ctrl-z,z

Notes:
  - Default state path: $STATE_DIR
  - Override with: ALPHAGSM_HOME=/absolute/path ./alphagsm-docker ...
    - Manager mode defaults to release mode:
            tries to pull $DEFAULT_MANAGER_IMAGE, then falls back to a local build.
    - start/up with --develop switches the state dir into developer mode:
            it always rebuilds locally with image tag $DEVELOP_MANAGER_IMAGE.
  - Runtime image pre-pull defaults to off in this wrapper. Set
            ALPHAGSM_PULL_RUNTIME_IMAGES=1 if you want eager GHCR pulls at startup.
    - ps reads local metadata and requires host python3.
    - Docker-backed <server> connect uses host metadata when available and
    otherwise falls back to AlphaGSM's normal forwarded `connect`.
                - --tail <n> shows the last n log lines before attach.
                - --no-logs skips the pre-attach log tail.
                                - --detach-keys <seq> overrides Docker's detach sequence for attach.
                                        Example: ctrl-z,z.
  - Docker-backed server install paths must stay under ALPHAGSM_HOME so the
    host Docker daemon and the manager container see the same absolute path.
EOF
}

main() {
    local command="${1:-help}"
    local mode

    case "$command" in
        help|-h|--help)
            show_help
            ;;
        up|start)
            shift
            command="$(parse_start_mode "$@")"
            ensure_manager "$command" 1
            persist_manager_mode "$command"
            ;;
        down|stop)
            shift
            manager_compose "$(current_manager_mode)" down "$@"
            ;;
        shell)
            shift
            ensure_manager "$(current_manager_mode)"
            manager_compose "$(current_manager_mode)" exec alphagsm bash "$@"
            ;;
        logs)
            shift
            ensure_config
            manager_compose "$(current_manager_mode)" logs -f alphagsm "$@"
            ;;
        compose)
            shift
            mode="$(current_manager_mode)"
            guard_existing_manager_identity "$mode"
            ensure_config
            manager_compose "$mode" "$@"
            ;;
        ps)
            shift
            require_host_python3
            print_docker_server_list "$@"
            ;;
        *)
            if [[ $# -ge 2 && "$2" == "connect" ]]; then
                route_connect_command "$@"
            else
                exec_alphagsm "$@"
            fi
            ;;
    esac
}

main "$@"
